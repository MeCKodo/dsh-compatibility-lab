{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MeCKodo/dsh-compatibility-lab/schema/receipt.schema.json",
  "title": "DSH compatibility receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fingerprint", "plugin", "environment", "status", "detail", "checks", "observed", "outputDigest", "testedAt", "runner"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "install", "profile"],
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 200 },
        "install": { "type": "string", "maxLength": 400 },
        "profile": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 64 }
      }
    },
    "environment": { "type": "object" },
    "status": { "enum": ["passed", "boot-failed", "needs-approval", "not-a-layer", "failed", "timeout", "inconclusive"] },
    "detail": { "type": "string", "maxLength": 300 },
    "checks": { "type": "object" },
    "observed": { "type": "object" },
    "outputDigest": { "type": ["string", "null"] },
    "testedAt": { "type": "string", "format": "date-time" },
    "runner": { "type": "object" }
  }
}
